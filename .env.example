# =============================================================================
# GaussMeridian Environment Configuration
#
#   cp .env.example .env && docker compose up -d
#
# Copied verbatim, this file boots a working gateway with ZERO provider API keys
# and zero spend — requests are served by the bundled mock provider. The values in
# the "Required" section below are DEVELOPMENT-ONLY and must be replaced before
# this stack is exposed to anything or anyone real.
#
# "Zero keys" means zero *provider* keys. The infrastructure secrets below are
# still required: docker-compose.yml declares them with `:?`, so the stack refuses
# to start rather than falling back to a silent built-in default.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — docker-compose.yml has no fallback for any of these.
# DEVELOPMENT-ONLY VALUES. Replace every one before any real deployment:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
SURREALDB_PASSWORD=dev-only-surrealdb-password-replace-me
REDIS_PASSWORD=dev-only-redis-password-replace-me
JWT_SECRET=dev-only-jwt-secret-at-least-32-characters-long-replace-me
GAUSSMERIDIAN_API_KEY=gm-dev-only-bootstrap-key-replace-me

# -----------------------------------------------------------------------------
# LLM Provider API Keys — ALL OPTIONAL.
#
# Left blank, the gateway routes to the bundled mock provider at
# http://mock-provider:8080/v1 and returns deterministic completions.
#
# To use your own model, set ONE of these and re-run `docker compose up -d`.
# Which provider actually served a request is visible in the response's
# `x-gaussmeridian-provider-selected` header.
#
# Known limitation, see README "Provider catalog": the OpenAI and Anthropic
# allowlists in gaussmeridian.toml are stale relative to their real catalogs, so
# those two providers cannot currently route even with a valid key. GEMINI_API_KEY
# works.
# -----------------------------------------------------------------------------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-openai-api-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key
# COHERE_API_KEY=your-cohere-api-key

# -----------------------------------------------------------------------------
# BYOK (customer-supplied provider keys)
#
# Left blank, compose injects a DEVELOPMENT-ONLY master key so the BYOK endpoints
# work out of the box. Generate your own before storing anything real:
#   openssl rand -base64 32
# BYOK_ADMIN_EMAILS gates key registration; leave blank to allow the first
# registered account.
# -----------------------------------------------------------------------------
BYOK_MASTER_KEY=
BYOK_ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Superadmin allowlist — comma-separated emails.
#
# `require_superadmin` returns 404 (deliberately not 403, so the surface is never
# advertised) for anyone not listed here. Unset, EVERY /v1/admin/* route is
# indistinguishable from a route that does not exist, and the endpoint evidence
# pack silently drops all 28 admin cases.
#
# The default below is the account the evidence harness registers, so that
# `cp .env.example .env && docker compose up -d` reproduces the full documented
# surface on a fresh database. REPLACE IT with your own operator address before
# any real deployment — anyone who can register this address gets the admin surface.
# -----------------------------------------------------------------------------
SUPERADMIN_EMAILS=user@example.com

# -----------------------------------------------------------------------------
# Observability profile (docker compose --profile observability up -d)
#
# GRAFANA_PASSWORD must stay UNCOMMENTED even if you never enable the profile:
# docker compose interpolates every service's variables before it filters by
# profile, so a missing `:?` value here fails `docker compose up` for the base
# stack too, not just for the observability one.
# -----------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=dev-only-grafana-password-replace-me

# -----------------------------------------------------------------------------
# Optional: external services
# -----------------------------------------------------------------------------
# Redis URL, if you run Redis outside this compose stack. The name is deliberately
# unprefixed — the server reads REDIS_URL and nothing else (services/server/src/app.rs:815).
# A value set as GAUSSMERIDIAN_REDIS_URL is read by no code in the workspace and silently
# leaves the gateway on its built-in redis://localhost:6379 default.
# REDIS_URL=redis://:your-password@your-redis-host:6379

# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn
