# =============================================================================
# GaussMeridian WebUI — Environment (template)
# Copy to `.env` and adjust for your setup. Only NEXT_PUBLIC_* is exposed to the
# browser; GAUSSMERIDIAN_API_URL is server-only (used by the proxy + auth route
# handlers). Prefer 127.0.0.1 over localhost so Node doesn't try IPv6 (::1)
# first when the backend binds 0.0.0.0 (IPv4).
# =============================================================================

# --- Backend API --------------------------------------------------------------
# Local default. Override this port to match wherever your backend is listening.
# Build-time public base URL, inlined into client bundles.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Runtime, server-only override (takes precedence over NEXT_PUBLIC_API_BASE_URL
# on the server). Point this at the backend for the proxy + auth handlers.
GAUSSMERIDIAN_API_URL=http://127.0.0.1:8000

# Canonical local browser origin. The backend's own console-base-URL setting must use
# the same value so any hosted redirect returns to the host that owns the WebUI's
# HttpOnly session cookie. In development, the WebUI redirects localhost here.
WEBUI_CANONICAL_ORIGIN=http://127.0.0.1:3000

# --- Dev-only mocking (src/@core/lib/env.ts, src/middleware.ts) -------------
# "1" serves the console from in-memory fixtures instead of a live backend, and bypasses the
# session-cookie redirect in middleware.ts for guarded routes. Never set in production — the
# middleware also hard-requires NODE_ENV !== "production" as a backstop (M6). Leave unset
# unless you are running the console against mocks with no backend available.
# NEXT_PUBLIC_USE_MOCKS=1

# --- Number formatting (src/utils/numberFormattingConfig.ts) -----------------
# Decimal places used when NEXT_PUBLIC_ROUND_NUMBER_APP is not "true" (default 2).
NEXT_PUBLIC_ROUND_DECIMALS=2
# "true" rounds numbers to integers app-wide (default false).
NEXT_PUBLIC_ROUND_NUMBER_APP=false
# Thousands separator: space (default) or comma. Quote to set a literal space.
# NEXT_PUBLIC_THOUSANDS_SEPARATOR=","
# Keep the local WebUI and backend on the same host so the host-only session cookie
# survives any hosted redirect round trip. Run `bun run dev` and open:
# http://127.0.0.1:3000
